#!/bin/bash
# App Center start/stop/status for fnmusic-ext.
#   start  = bring the sources container up and enable the socket-takeover proxy
#   stop   = stop the proxy (unit ExecStopPost restores the official socket) and the container
#   status = exit 0 running / exit 3 stopped
set -uo pipefail

SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
. "${SELF_DIR}/_common"

UNIT="fnmusic-ext.service"

fnmusic_running_ready() {
    # App Center may lose its running state after an external deployment.
    # A repeated start must acknowledge this healthy installation without
    # rebuilding its image or interrupting playback. Never borrow another repo.
    local owner
    systemctl is-active --quiet "${UNIT}" 2>/dev/null || return 1
    owner="$(systemctl show "${UNIT}" -p WorkingDirectory --value 2>/dev/null)" || return 1
    [ -n "${owner}" ] || return 1
    [ "$(cd "${owner}" 2>/dev/null && pwd -P)" = "$(cd "${FNMUSIC_REPO_DIR}" && pwd -P)" ] || return 1
    # The official music SPA also returns 200 for unknown paths: check JSON,
    # including dependency readiness, rather than accepting HTTP status alone.
    curl -fsS --connect-timeout 2 --max-time 5 \
        --unix-socket /var/run/trim_music.socket http://localhost/_ext/healthz 2>/dev/null \
        | python3 -c '
import json, sys
try:
    health = json.load(sys.stdin)
    ready = health.get("ok") is True and health.get("degraded") is False
except (ValueError, AttributeError):
    ready = False
sys.exit(0 if ready else 1)
' 2>/dev/null
}

case "${1:-}" in
    start)
        [ -n "${FNMUSIC_REPO_DIR}" ] || fnmusic_fail "应用文件缺失（install.sh 不存在），请卸载后重新安装"
        [ -f "${FNMUSIC_REPO_DIR}/.env" ] || fnmusic_fail "尚未完成安装配置（.env 缺失），请卸载后重新安装"
        if fnmusic_running_ready; then
            exit 0
        fi
        # extend.sh is idempotent: ensures the unit exists, starts the proxy and
        # takes over /var/run/trim_music.socket. Non-TTY never prompts.
        if ! bash "${FNMUSIC_REPO_DIR}/extend.sh" >> "${FNMUSIC_LOG}" 2>&1; then
            tail -n 5 "${FNMUSIC_LOG}" >&2 || true
            fnmusic_fail "启动失败：详见 ${FNMUSIC_LOG}"
        fi
        exit 0
        ;;
    stop)
        # Stopping the unit restores the official socket via ExecStopPost.
        systemctl stop "${UNIT}" >> "${FNMUSIC_LOG}" 2>&1 || true
        if [ -n "${FNMUSIC_REPO_DIR}" ] && [ -f "${FNMUSIC_REPO_DIR}/docker-compose.yml" ]; then
            docker compose -f "${FNMUSIC_REPO_DIR}/docker-compose.yml" stop >> "${FNMUSIC_LOG}" 2>&1 || true
        fi
        exit 0
        ;;
    status)
        if systemctl is-active --quiet "${UNIT}"; then
            exit 0
        fi
        exit 3
        ;;
    *)
        exit 1
        ;;
esac
